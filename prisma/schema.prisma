generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  passwordHash  String?   @db.Text
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  comments      Comment[]
  issues        Issue[]   @relation("IssueCreator")
  ownedProjects Project[] @relation("ProjectOwner")
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Issue {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255) //default is 191
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  status      Status   @default(OPEN)
  creatorId   String?
  creator     User?    @relation("IssueCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  comments    Comment[]

  @@index([creatorId])
}

model Project {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(255)
  description String?       @db.Text
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  dueDate     DateTime?
  ownerId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  owner        User?         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  unitProjects UnitProject[]

  @@index([ownerId])
  @@index([status])
}

model UnitProject {
  id                 Int        @id @default(autoincrement())
  projectId          Int
  name               String     @db.VarChar(255)
  code               String?    @db.VarChar(80)
  description        String?    @db.Text
  status             WorkStatus @default(PLANNED)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  progress           Int        @default(0)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionWorks DivisionWork[]

  @@index([projectId])
  @@index([status])
  @@index([plannedEndDate])
}

model DivisionWork {
  id                 Int        @id @default(autoincrement())
  unitProjectId      Int
  name               String     @db.VarChar(255)
  code               String?    @db.VarChar(80)
  description        String?    @db.Text
  category           String?    @db.VarChar(120)
  status             WorkStatus @default(PLANNED)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  progress           Int        @default(0)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  unitProject  UnitProject   @relation(fields: [unitProjectId], references: [id], onDelete: Cascade)
  subItemWorks SubItemWork[]

  @@index([unitProjectId])
  @@index([status])
  @@index([plannedEndDate])
}

model SubItemWork {
  id                 Int        @id @default(autoincrement())
  divisionWorkId     Int
  name               String     @db.VarChar(255)
  code               String?    @db.VarChar(80)
  description        String?    @db.Text
  trade              String?    @db.VarChar(120)
  quantity           Decimal?   @db.Decimal(12, 2)
  unit               String?    @db.VarChar(40)
  status             WorkStatus @default(PLANNED)
  plannedStartDate   DateTime?
  plannedEndDate     DateTime?
  actualStartDate    DateTime?
  actualEndDate      DateTime?
  progress           Int        @default(0)
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  divisionWork DivisionWork @relation(fields: [divisionWorkId], references: [id], onDelete: Cascade)

  @@index([divisionWorkId])
  @@index([status])
  @@index([plannedEndDate])
}

model Comment {
  id        Int      @id @default(autoincrement())
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  issueId   Int
  authorId  String

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId])
  @@index([authorId])
}

enum Status {
  OPEN
  CLOSED
  IN_PROGRESS
}

enum UserRole {
  USER
  ADMIN
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum WorkStatus {
  PLANNED
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}
